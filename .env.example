# Local environment settings. Add a fresh token only on this machine.
ECOBUILD_CHECKPOINTS_DIR=checkpoints
ECOBUILD_MODEL_NAME=ecobuild_pix2pix
ECOBUILD_MODEL_EPOCH=latest
ECOBUILD_NET_G=unet_256
ECOBUILD_NGF=64
ECOBUILD_NORM=batch
ECOBUILD_USE_DROPOUT=true

# Cloudflare Workers AI. Add your account ID and token to your local .env.
ECOBUILD_IMAGE_PROVIDER=cloudflare
ECOBUILD_CF_ACCOUNT_ID=your_32_character_account_id
ECOBUILD_CF_API_TOKEN=
ECOBUILD_CF_MODEL=@cf/black-forest-labs/flux-2-klein-4b
